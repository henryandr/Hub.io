// Configuration file for the hub.io data getter
// Centro de Bioingenieria UPB V 1.0
// June 2017

{
	"version" : "1.0",
	"log_path" : "./Logs/report.log",
	"debug" : "true", // This activate console logs
	"interfaces" : [
		{
			"type" : "wifi",
			"uart" : "/dev/ttyO2",
			"baudrate" : 9600
		},
		{
			"type" : "zigbee",
			"uart" : "/dev/ttyO3",
			"baudrate" : 115200
		},
		{
			"type" : "ble",
			"uart" : "/dev/ttyO4",
			"baudrate" : 9600
		}
	],
	"HL7_v" : "2.6",
	"base_url" : "http://localhost:8080/api/",
	"api_v" : "0.1"
}
